# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.eslintcache

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit a real one. The template is the sole exception.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# INFO: steiger transpiles its config beside itself, under a per-run uuid.
steiger.config.ts.*.mjs

# INFO: Build output — `pnpm precache` writes it from .next/static after every build.
/public/offline-precache.json

# INFO: `pnpm ffmpeg-core` copies these from node_modules/@ffmpeg/core at build and dev time.
/public/ffmpeg/

# Claude Code scratch — agent worktrees are clones of this repo, never content of it.
.claude/

# INFO: The restructure plan is working notes, not a shipped document.
docs/RESTRUCTURE.md
