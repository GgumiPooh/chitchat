# WARN: Site addresses, straight from the app's own APP_URLS — one place to add or
# retire a domain instead of two drifting lists. Caddy's Caddyfile tokenizes site
# addresses on whitespace (a trailing comma is stripped, but doesn't separate on
# its own), so APP_URLS in .env MUST be comma-AND-space separated here, not the
# bare comma the app code alone would also accept.
{$APP_URLS} {
	handle /_next/static/* {
		root * /srv/www/jandh

		# WARN: `route` preserves the order written here. Caddy's own directive order runs
		# reverse_proxy before file_server, so inside a bare handle block the proxy answers
		# every request and the disk copy is never consulted.
		route {
			file_server {
				pass_thru
			}
			reverse_proxy jandh-app:3000
		}
	}

	handle {
		reverse_proxy jandh-app:3000 {
			flush_interval -1
		}
	}
}

import /etc/caddy/sites/*.caddy
