{
  "name": "jandh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "lint": "pnpm lint:eslint && pnpm lint:steiger",
    "lint:eslint": "eslint --cache",
    "lint:steiger": "steiger src",
    "format": "prettier --write .",
    "icons": "node node_modules/tsx/dist/cli.mjs scripts/generate-icons.ts",
    "ffmpeg-core": "node node_modules/tsx/dist/cli.mjs scripts/generate-ffmpeg-core.ts",
    "holidays": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs scripts/generate-holidays.ts",
    "ops:backup": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.ops.json scripts/ops/backup.ts",
    "ops:purge": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.ops.json scripts/ops/purge.ts",
    "ops:sweep": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.ops.json scripts/ops/sweep.ts",
    "ops:orphans": "node --env-file-if-exists=.env.local node_modules/tsx/dist/cli.mjs --tsconfig tsconfig.ops.json scripts/ops/orphans.ts",
    "dev": "concurrently -n app,steiger,tunnel -c blue,yellow,red \"pnpm dev:app\" \"pnpm dev:steiger\" \"pnpm dev:tunnel\"",
    "predev:app": "pnpm ffmpeg-core",
    "dev:app": "next dev",
    "dev:steiger": "steiger src --watch",
    "dev:tunnel": "sudo brew services start tailscale; sudo tailscale funnel 3000",
    "build": "pnpm ffmpeg-core && pnpm lint:steiger && pnpm build:app && pnpm precache",
    "build:app": "next build",
    "precache": "node node_modules/tsx/dist/cli.mjs scripts/generate-offline-precache.ts",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.958.0",
    "@aws-sdk/lib-storage": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.958.0",
    "@chenglou/pretext": "^0.0.8",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/avif": "2.1.1",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-virtual": "^3.14.9",
    "arctic": "^3.7.0",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "es-hangul": "^2.4.0",
    "jose": "^6.1.0",
    "lodash-es": "^4.17.21",
    "lucide-react": "^1.14.0",
    "mediabunny": "1.52.3",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.7",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-advanced-cropper": "^0.20.1",
    "react-dom": "19.2.4",
    "react-error-boundary": "^6.1.2",
    "react-intersection-observer": "^10.0.3",
    "react-use": "^17.6.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "synced-storage": "^1.3.3",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.10.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@ffmpeg/core": "0.12.10",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.100.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.9.0",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "sharp": "^0.35.3",
    "steiger": "^0.5.11",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
